# Automatic HTTPS (Let's Encrypt). Set CTDMS_DOMAIN in .env and point DNS to this server.
{$CTDMS_DOMAIN:localhost} {
    encode gzip
    reverse_proxy app:8000
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
    }
    request_body {
        max_size 25MB
    }
    # App restarting or being updated: show the bilingual "server down" page instead of a browser error.
    handle_errors {
        @down expression `{err.status_code} in [502, 503, 504]`
        handle @down {
            root * /srv
            rewrite * /server_down.html
            file_server
        }
    }
}
