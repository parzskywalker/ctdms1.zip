# ---- CTDMS configuration (copy to .env) -------------------------------------------------
CTDMS_ENVIRONMENT=production
# Long random string, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
CTDMS_SECRET_KEY=change-me-to-a-long-random-secret
# Set true when served over HTTPS (Caddy/nginx in front)
CTDMS_SESSION_COOKIE_SECURE=false
CTDMS_SESSION_IDLE_MINUTES=480
CTDMS_JWT_EXPIRE_MINUTES=720
# Show the clickable demo users on the login page (false in production)
CTDMS_SHOW_DEMO_LOGINS=false
# Load the demo dataset on first start when the database is empty
CTDMS_SEED_DEMO=false
CTDMS_MAX_UPLOAD_MB=20
# Swagger UI at /api/docs (default: hidden in production)
# CTDMS_API_DOCS_PUBLIC=false
# Proxies allowed to pass the real client IP (X-Forwarded-For). With the Caddy profile: 172.16.0.0/12
FORWARDED_ALLOW_IPS=127.0.0.1
CTDMS_TIMEZONE=Asia/Kolkata
# Read photographed / scanned transporter bills automatically (Anthropic API key, from console.anthropic.com).
# Leave empty to type the bill lines next to the photo instead. Bill photos are sent to the Anthropic API.
# CTDMS_ANTHROPIC_API_KEY=
# Token for customer WhatsApp / SMS alerts (WhatsApp Cloud API or SMS gateway); provider is chosen in System Settings
# CTDMS_NOTIFY_TOKEN=

# Local run without Docker (SQLite is fine for a demo / single site):
# CTDMS_DATABASE_URL=sqlite:///./data/ctdms.db
# PostgreSQL:
# CTDMS_DATABASE_URL=postgresql+psycopg://ctdms:password@localhost:5432/ctdms

# ---- docker compose ---------------------------------------------------------------------
POSTGRES_DB=ctdms
POSTGRES_USER=ctdms
POSTGRES_PASSWORD=change-me-db-password
CTDMS_PORT=8000
CTDMS_DOMAIN=ctdms.example.com
BACKUP_KEEP_DAYS=30
SYNC_INTERVAL_SECONDS=900
